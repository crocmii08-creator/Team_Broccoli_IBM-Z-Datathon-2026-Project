  "narrative": {
    "northStar": "The expressive line companion",
    "overview": "This records the user-approved companion redesign in `kaki-demo.html`, using the pinned HeyClicky character as its reference. A sparse, angular happy face feels friendly through expression and rounded strokes. Kaki retains its teal identity and switches to concern for warnings.\n\nThis is a component system, not a new whole-page identity. The surrounding demo, phone, controls and app screens remain incumbent context; their observed colors below are descriptive rather than new system commitments.",
    "keyCharacteristics": [
      "Minimal inline SVG line geometry.",
      "Happy guidance and concerned warning expressions.",
      "Readable captions and one foreground companion.",
      "Speech-linked motion with reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Caption Rule",
        "body": "Every spoken line retains a visible caption; update the existing text span rather than adding duplicate text.",
        "section": "typography"
      },
      {
        "name": "The One Foreground Face Rule",
        "body": "Hide resting duplicates while a guidance caption is shown; hide background guidance captions and resting faces while alert overlays are visible.",
        "section": "components"
      }
    ],
    "dos": [
      "Do retain teal happy strokes, white backing and yellow-backed concern.",
      "Do keep captions readable in English, Mandarin, Malay and Tamil.",
      "Do bind mouth motion to speech events and honor reduced-motion.",
      "Do show one foreground companion during guidance and warnings."
    ],
    "donts": [
      "Don't restore the old dotted-halo mascot in this component.",
      "Don't animate a speaking mouth merely because a caption is visible.",
      "Don't treat this component guide as authorization to redesign the surrounding demo."
    ]
  }
